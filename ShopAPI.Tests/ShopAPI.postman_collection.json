{
  "info": {
    "name": "ShopAPI Acceptance Tests",
    "description": "Automated acceptance tests for ShopAPI — import this into Postman and run the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base", "value": "http://localhost:5000" }],
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "GET all categories",
          "request": { "method": "GET", "url": "{{base}}/api/categories" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
            "pm.test('Has HATEOAS links', () => { const body = pm.response.json(); pm.expect(body[0]).to.have.property('links'); });"
          ]}}]
        },
        {
          "name": "POST create category",
          "request": {
            "method": "POST",
            "url": "{{base}}/api/categories",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Test Category\", \"description\": \"For testing\" }" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Returns created category', () => { const b = pm.response.json(); pm.expect(b.name).to.eq('Test Category'); });",
            "pm.collectionVariables.set('catId', pm.response.json().id);"
          ]}}]
        },
        {
          "name": "GET category by id",
          "request": { "method": "GET", "url": "{{base}}/api/categories/1" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has id', () => pm.expect(pm.response.json()).to.have.property('id'));"
          ]}}]
        },
        {
          "name": "DELETE non-existent category returns 404",
          "request": { "method": "DELETE", "url": "{{base}}/api/categories/99999" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ]}}]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "GET all products",
          "request": { "method": "GET", "url": "{{base}}/api/products" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Array with HATEOAS links', () => { const b = pm.response.json(); pm.expect(b).to.be.an('array'); pm.expect(b[0].links).to.have.keys(['self','update','delete','all']); });"
          ]}}]
        },
        {
          "name": "POST create product",
          "request": {
            "method": "POST",
            "url": "{{base}}/api/products",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Test Product\", \"description\": \"A test item\", \"price\": 49.99, \"stock\": 10, \"categoryId\": 1 }" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Price matches', () => pm.expect(pm.response.json().price).to.eq(49.99));",
            "pm.collectionVariables.set('productId', pm.response.json().id);"
          ]}}]
        },
        {
          "name": "GET product by id",
          "request": { "method": "GET", "url": "{{base}}/api/products/{{productId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Correct name', () => pm.expect(pm.response.json().name).to.eq('Test Product'));"
          ]}}]
        },
        {
          "name": "GET products filtered by category",
          "request": { "method": "GET", "url": "{{base}}/api/products?categoryId=1" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('All in category 1', () => { pm.response.json().forEach(p => pm.expect(p.categoryId).to.eq(1)); });"
          ]}}]
        },
        {
          "name": "PUT update product",
          "request": {
            "method": "PUT",
            "url": "{{base}}/api/products/{{productId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Updated Product\", \"description\": \"Updated desc\", \"price\": 59.99, \"stock\": 5, \"categoryId\": 1 }" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Name updated', () => pm.expect(pm.response.json().name).to.eq('Updated Product'));"
          ]}}]
        },
        {
          "name": "POST product with invalid category returns 404",
          "request": {
            "method": "POST",
            "url": "{{base}}/api/products",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Bad Product\", \"price\": 10, \"stock\": 1, \"categoryId\": 99999 }" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ]}}]
        },
        {
          "name": "DELETE product",
          "request": { "method": "DELETE", "url": "{{base}}/api/products/{{productId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 204', () => pm.response.to.have.status(204));"
          ]}}]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "GET all orders",
          "request": { "method": "GET", "url": "{{base}}/api/orders" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}]
        },
        {
          "name": "POST create order",
          "request": {
            "method": "POST",
            "url": "{{base}}/api/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"customerName\": \"Jane Doe\", \"customerEmail\": \"jane@test.com\", \"items\": [{ \"productId\": 1, \"quantity\": 2 }] }" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Has total', () => pm.expect(pm.response.json().total).to.be.a('number'));",
            "pm.test('Default status Pending', () => pm.expect(pm.response.json().status).to.eq('Pending'));",
            "pm.collectionVariables.set('orderId', pm.response.json().id);"
          ]}}]
        },
        {
          "name": "PATCH update order status",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/api/orders/{{orderId}}/status",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"Confirmed\" }" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status updated', () => pm.expect(pm.response.json().status).to.eq('Confirmed'));"
          ]}}]
        },
        {
          "name": "POST order with out-of-stock product returns 400",
          "request": {
            "method": "POST",
            "url": "{{base}}/api/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"customerName\": \"Test\", \"customerEmail\": \"t@t.com\", \"items\": [{ \"productId\": 1, \"quantity\": 999999 }] }" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));"
          ]}}]
        }
      ]
    }
  ]
}
